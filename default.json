{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate defaults for twisted-binary and tmbs88 repos",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Zurich",
  "schedule": ["* 0-6 * * 1"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "platformAutomerge": false,
  "composerIgnorePlatformReqs": ["ext-*", "lib-*"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-6 1 * *"]
  },
  "packageRules": [
    {
      "description": "Lock file maintenance has no release timestamp, so the age gate would hold it forever (Renovate 42+)",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    {
      "description": "One weekly PR for all minor and patch updates (0.x minors can break, so they stay separate)",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^v?0\\./",
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    },
    {
      "description": "Keep @types/node on the Node major that CI and production run",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    },
    {
      "description": "Node engines and packageManager fields are changed by hand",
      "matchDepTypes": ["engines", "packageManager"],
      "enabled": false
    },
    {
      "description": "Group GitHub Actions bumps",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Shared workflows are referenced by their moving major tag, not a digest",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["twisted-binary/ci"],
      "pinDigests": false
    }
  ]
}
